<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>MediCare | Sign in</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body class="login-bg"><main class="card shadow-sm p-4 login-card"><h1 class="h3 text-primary">MediCare</h1><p class="text-muted">Hospital Management System</p><% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger"><%= request.getAttribute("error") %></div><% } %><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input class="form-control mb-3" name="email" type="email" placeholder="Email" required><input class="form-control mb-3" name="password" type="password" placeholder="Password" required><button class="btn btn-primary w-100">Sign in</button></form><a class="mt-3" href="${pageContext.request.contextPath}/register">Create patient account</a></main></body></html>
