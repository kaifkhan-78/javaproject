<%@ page import="java.util.*,in.ac.rtu.medicare.model.Appointment" %><!doctype html><html><head><title>Appointments | MediCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><main class="container py-4"><a href="${pageContext.request.contextPath}/app/dashboard">← Dashboard</a><h1 class="my-3">Appointments</h1><% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger"><%=request.getAttribute("error")%></div><% } %><table class="table table-striped"><thead><tr><th>When</th><th>Reason</th><th>Status</th></tr></thead><tbody><% for(Appointment a:(List<Appointment>)request.getAttribute("appointments")){ %><tr><td><%=a.appointmentAt()%></td><td><%=a.reason()%></td><td><%=a.status()%></td></tr><% } %></tbody></table></main></body></html>
