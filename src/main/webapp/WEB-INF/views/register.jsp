<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>Register | MediCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body class="login-bg"><main class="card shadow-sm p-4 login-card"><h1 class="h3">Patient registration</h1><% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger"><%= request.getAttribute("error") %></div><% } %><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input class="form-control mb-2" name="name" placeholder="Full name" required maxlength="100"><input class="form-control mb-2" name="email" type="email" placeholder="Email" required><input class="form-control mb-2" name="phone" placeholder="Phone" maxlength="20"><input class="form-control mb-3" name="password" type="password" placeholder="Password (8+ characters)" minlength="8" required><button class="btn btn-primary w-100">Register</button></form></main></body></html>
